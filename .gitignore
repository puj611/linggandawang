!mcp-server/smoke-test.mjs
# 例外：版本一致性校验脚本需要入库（R03）
!scripts/check-version.mjs

# 环境变量和敏感文件
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.jks

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 运行时生成的配置文件
context.json
window-position.json
user-bank.yaml

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# IDE配置
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# 备份文件
*.bak
*.bak.*
*.backup

# 临时文件
*.tmp
*.temp

# 测试覆盖率
coverage/
*.lcov

# 本地开发文件
.tauri/

# 编辑器特定文件
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

