{
 "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
 "productName": "LingGanDaWang",
 "version": "0.9.2",
 "identifier": "com.linggandawang.app",
 "build": {
  "frontendDist": "../dist",
  "beforeDevCommand": "c:/Users/puj/AppData/Local/Agnes/node/npm.cmd run dev",
  "devUrl": "http://localhost:5173",
  "beforeBuildCommand": ""
 },
 "app": {
  "windows": [
   {
    "label": "main",
    "title": "灵感大王",
    "width": 420,
    "height": 700,
    "minWidth": 380,
    "minHeight": 500,
    "resizable": false,
    "maximizable": false,
    "minimizable": true,
    "closable": true,
    "center": true,
    "alwaysOnTop": true,
    "focus": true,
    "decorations": false,
    "transparent": true,
    "skipTaskbar": false,
    "visible": true,
    "shadow": false,
    "dragDropEnabled": true
   }
  ],
   "security": {
    "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.deepseek.com https://api.openai.com https://dashscope.aliyuncs.com https://huggingface.co https://cas-bridge.xethub.hf.co https://us.aws.cdn.hf.co http://localhost:11434 http://127.0.0.1:11434 http://localhost:8080 http://127.0.0.1:8080; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'",
   "freezePrototype": true
  }
 },
 "bundle": {
  "active": true,
  "createUpdaterArtifacts": true,
  "targets": [
   "nsis"
  ],
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png",
   "icons/icon.icns",
   "icons/icon.ico"
  ],
  "android": {
   "debugApplicationIdSuffix": ".debug"
  }
 },
 "plugins": {
  "updater": {
   "endpoints": [
    "https://github.com/puj611/linggandawang/releases/latest/download/latest.json"
   ],
   "dialog": false,
   "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMDA3QTgwMEZGQkMyRjIKUldUeXd2c1BnSG9BcjJRVktGeDZVVlNlNmlNWFVadTljcmZhbjV2elp4a2FOR0tteHpKREp2cFUK"
  }
 }
}
