{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for the desktop app",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "global-shortcut:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "sql:default",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "identifier": "sqlite:linggandawang.db" }]
    },
    {
      "identifier": "sql:allow-execute",
      "allow": [{ "identifier": "sqlite:linggandawang.db" }]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [{ "identifier": "sqlite:linggandawang.db" }]
    },
    {
      "identifier": "sql:allow-close",
      "allow": [{ "identifier": "sqlite:linggandawang.db" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
